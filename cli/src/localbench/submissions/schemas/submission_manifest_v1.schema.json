{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localbench.submission-manifest.v1",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selection_policy_id", "selection_reason", "template_source", "template_sha256", "chat_template_kwargs", "answer_stops", "runtime_probe_passed", "prompt_renderer_engine"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selection_policy_id": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1},
        "template_source": {"type": "string", "minLength": 1},
        "template_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "chat_template_kwargs": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "answer_stops": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "runtime_probe_passed": {"type": "boolean"},
        "prompt_renderer_engine": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "required": ["schema_version", "payload", "payload_sha256", "signature"],
  "properties": {
    "schema_version": { "const": "localbench.submission-manifest.v1" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "required": ["submission_format", "created_at", "run_nonce", "ticket", "suite", "scorecard", "files", "counts"],
      "properties": {
        "submission_format": { "const": "localbench.submission-bundle.v1" },
        "created_at": { "type": "string" },
        "run_nonce": { "type": "string" },
        "ticket": { "type": "object" },
        "suite": { "type": "object" },
        "scorecard": { "type": "object" },
        "execution_profile": {"$ref": "#/$defs/executionProfile"},
        "files": { "type": "array" },
        "counts": { "type": "object" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "public_key", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}
